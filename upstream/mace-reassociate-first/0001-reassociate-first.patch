+++ b/tests/unit/test_reassociate.py
@@ -0,0 +1,69 @@
+import numpy as np
+import pytest
+import torch
+from e3nn import o3
+
+from mace import data, modules, tools
+from mace.modules.reassociate import (
+    ReassociatedFirstConvolution,
+    reassociate_first_interaction,
+)
+from mace.tools import torch_geometric
+
+torch.set_default_dtype(torch.float64)
+
+
+def _model(interaction_cls):
+    torch.manual_seed(3)
+    return modules.MACE(
+        r_max=4.0,
+        num_bessel=8,
+        num_polynomial_cutoff=6,
+        max_ell=3,
+        interaction_cls=interaction_cls,
+        interaction_cls_first=interaction_cls,
+        num_interactions=2,
+        num_elements=3,
+        hidden_irreps=o3.Irreps("16x0e+16x1o"),
+        MLP_irreps=o3.Irreps("8x0e"),
+        gate=torch.nn.functional.silu,
+        atomic_energies=np.zeros(3),
+        avg_num_neighbors=8.0,
+        atomic_numbers=[11, 17, 41],
+        correlation=3,
+        radial_type="bessel",
+    )
+
+
+def _batch(model):
+    from ase.build import bulk
+
+    atoms = bulk("NaCl", "rocksalt", a=5.64).repeat((2, 2, 1))
+    atoms.numbers[3] = 41
+    atoms.rattle(0.05, seed=1)
+    table = tools.AtomicNumberTable([11, 17, 41])
+    config = data.config_from_atoms(atoms)
+    graph = data.AtomicData.from_config(config, z_table=table, cutoff=4.0)
+    batch = next(iter(torch_geometric.dataloader.DataLoader([graph], batch_size=1)))
+    batch.positions.requires_grad_(True)
+    return batch.to_dict()
+
+
+@pytest.mark.parametrize(
+    "interaction_cls",
+    [
+        modules.interaction_classes["RealAgnosticResidualInteractionBlock"],
+        modules.interaction_classes["RealAgnosticDensityResidualInteractionBlock"],
+        modules.interaction_classes["RealAgnosticResidualNonLinearInteractionBlock"],
+    ],
+)
+@pytest.mark.parametrize("columns", [None, [0, 1, 2]])
+def test_reassociated_first_interaction_matches(interaction_cls, columns):
+    model = _model(interaction_cls)
+    batch = _batch(model)
+    expected = model(dict(batch), training=False, compute_force=True)
+    assert reassociate_first_interaction(model, species_columns=columns)
+    assert isinstance(model.interactions[0].conv_tp, ReassociatedFirstConvolution)
+    got = model(dict(batch), training=False, compute_force=True)
+    torch.testing.assert_close(got["energy"], expected["energy"], rtol=1e-10, atol=1e-10)
+    torch.testing.assert_close(got["forces"], expected["forces"], rtol=1e-9, atol=1e-10)
