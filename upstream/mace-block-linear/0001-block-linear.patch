@@ -0,0 +1,54 @@
+import pytest
+import torch
+
+cue = pytest.importorskip("cuequivariance")
+cuet = pytest.importorskip("cuequivariance_torch")
+
+from mace.modules.block_linear import (  # noqa: E402
+    BlockLinear,
+    block_linear,
+    convert_block_linears,
+)
+
+IRREPS = [
+    ("128x0e+128x1o+128x2e+128x3o", "512x0e+512x1o+512x2e+512x3o"),
+    ("64x0e+64x1o+64x1o+64x2e", "32x0e+48x1o+16x2e"),  # repeated irrep: grouped path
+    ("16x0e+8x1o", "16x0e+8x1o+4x2e"),  # output irrep without input: zero block
+]
+
+
+@pytest.mark.parametrize("layout", ["mul_ir", "ir_mul"])
+@pytest.mark.parametrize("grouped", [False, True])
+@pytest.mark.parametrize("irreps_in,irreps_out", IRREPS)
+def test_block_linear_matches_cuet(layout, grouped, irreps_in, irreps_out):
+    torch.manual_seed(0)
+    linear = cuet.Linear(
+        cue.Irreps("O3", irreps_in),
+        cue.Irreps("O3", irreps_out),
+        layout=getattr(cue, layout),
+        shared_weights=True,
+        method="naive",
+        dtype=torch.float64,
+    )
+    with torch.no_grad():
+        linear.weight.normal_()
+    converted = block_linear(linear, grouped=grouped)
+    assert isinstance(converted, BlockLinear)
+    x = torch.randn(7, cue.Irreps("O3", irreps_in).dim, dtype=torch.float64, requires_grad=True)
+    grad = torch.randn(7, cue.Irreps("O3", irreps_out).dim, dtype=torch.float64)
+    expected = linear(x)
+    (expected_grad,) = torch.autograd.grad(expected, x, grad)
+    got = converted(x)
+    (got_grad,) = torch.autograd.grad(got, x, grad)
+    torch.testing.assert_close(got, expected, rtol=1e-12, atol=1e-12)
+    torch.testing.assert_close(got_grad, expected_grad, rtol=1e-12, atol=1e-12)
+
+
+def test_convert_skips_non_cuet_modules():
+    model = torch.nn.Sequential(
+        torch.nn.Linear(4, 4),
+        cuet.Linear(cue.Irreps("O3", "4x0e"), cue.Irreps("O3", "4x0e"), layout=cue.mul_ir,
+                    method="naive", dtype=torch.float64),
+    )
+    assert convert_block_linears(model) == ["1"]
+    assert isinstance(model[0], torch.nn.Linear)
