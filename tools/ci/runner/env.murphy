# The murphy runner's .env (plan task 2-T18): copy to /mnt/homes/zwingel/actions-runner/murphy/.env.
# The runner reads it at start and gives every job these variables; gpu.yml names no machine path.
# Everything stays under /mnt/homes/zwingel (ResearchModule's AGENTS.md), in a cache of its own.
FASTMACE_CI_PYTHON=/mnt/homes/zwingel/environments/mace_cueq_latest/bin/python
FASTMACE_HYBRID_PYTHON=/mnt/homes/zwingel/environments/mace_cueq_oeq/bin/python
FASTMACE_MODELS=/mnt/homes/zwingel/ResearchModule/Models
FASTMACE_BASELINE=/mnt/homes/zwingel/fastmace-baseline/1a-T18
FASTMACE_CACHE=/mnt/homes/zwingel/fastmace-cache/ci-murphy
FASTMACE_CI_BASETEMP=/mnt/homes/zwingel/fastmace-cache/ci-murphy/pytest
TMPDIR=/mnt/homes/zwingel/fastmace-cache/ci-murphy/tmp
XDG_CACHE_HOME=/mnt/homes/zwingel/fastmace-cache/ci-murphy/xdg
TORCHINDUCTOR_COMPILE_THREADS=4
LD_LIBRARY_PATH=/mnt/homes/zwingel/environments/mace_cueq_latest/lib/python3.10/site-packages/nvidia/cu13/lib:/mnt/homes/zwingel/environments/mace_cueq_latest/lib/python3.10/site-packages/cuequivariance_ops/lib
FASTMACE_CI_GPU_SOURCE=nvidia-smi
