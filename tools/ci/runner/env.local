# The local runner's .env (plan task 2-T18): copy to ~/actions-runner/local/.env in WSL.
# The runner reads it at start and gives every job these variables; gpu.yml names no machine path.
# WSL cannot see Windows programs or other WSL processes through nvidia-smi, so the idle check uses the
# processes holding /dev/dxg plus memory, utilization and RAM limits: the desktop takes about 4.3 GB of the
# 16 GB, and WSL needs 10 GB available before a GPU suite (plans/phase-2.md, resource rules). The tests hold
# the local GPU reservation (tools/ci/local_gpu.py); its marker is absolute, because keepalive.sh moves HOME.
FASTMACE_CI_PYTHON=/home/fzwin/environments/mace_cueq_latest/bin/python
FASTMACE_HYBRID_PYTHON=/home/fzwin/environments/mace_cueq_oeq/bin/python
FASTMACE_MODELS=/home/fzwin/models
FASTMACE_BASELINE=/home/fzwin/fastmace-baseline/1a-T18
FASTMACE_CACHE=/home/fzwin/fastmace-cache/ci-local
FASTMACE_CI_BASETEMP=/home/fzwin/fastmace-cache/ci-local/pytest
TMPDIR=/home/fzwin/fastmace-cache/ci-local/tmp
TORCHINDUCTOR_COMPILE_THREADS=4
FASTMACE_CI_GPU_SOURCE=wsl
FASTMACE_CI_MAX_MEMORY_MIB=6000
FASTMACE_CI_MAX_UTILIZATION=15
FASTMACE_CI_IDLE_SAMPLES=3
FASTMACE_CI_MIN_AVAILABLE_GIB=10
FASTMACE_LOCAL_GPU_MARKER=/home/fzwin/.fastmace-local-gpu
