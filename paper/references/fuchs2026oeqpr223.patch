+
+def test_vmap_streaming_preserves_padded_sentinel(with_jax):
+    """Match independent streaming calls with one padded batched launch."""
+    if not with_jax:
+        pytest.skip("Skipping JAX tests")
+    os.environ["OEQ_NOTORCH"] = "1"
