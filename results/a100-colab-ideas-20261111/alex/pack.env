# GHOIST against the A100 defaults on Alex A100-SXM4-80GB (11 Nov 2026): Benchmark_loup SrTiO3 10x10x10 and NbCl5 3x3x3.
B=/home/atuin/v130cb/v130cb18/fm-a100omat   # env, models, baseline of the a100-omat0-best lane (read only)
M=/home/atuin/v130cb/v130cb18/fm-a100colab
FM_ROOT=$B
SRC=$M/src-cd7575bb
OUT=$M/runs/pack-$SLURM_JOB_ID
STAGE=0
CACHE=$M/cache
PACK="ghoist|fastmace.kernels.oeq_streaming.spline_forward:GHOIST=True"
MODELS="omat0-medium=mace-omat-0-medium.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10 NbCl5"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5"
