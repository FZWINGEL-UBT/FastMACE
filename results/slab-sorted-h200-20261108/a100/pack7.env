# Slab sort and species blocks on the A100 (8 November 2026): side a = the A100 defaults of fastmace/slab-sorted
# 59c1034e (both switches off off the H200); b = SORT_BY_LENGTH, BLOCK_ORDER, then both.
B=/home/atuin/v130cb/v130cb18/fm-a100omat
FM_ROOT=$B
SRC=$B/src-59c1034e
OUT=$B/runs/pack7-$SLURM_JOB_ID
STAGE=0
n=fastmace.neighbors.skin
s=fastmace.kernels.oeq_streaming.spline_forward
PACK="sorted|$n:SORT_BY_LENGTH=True;order|$s:BLOCK_ORDER=True;both|$n:SORT_BY_LENGTH=True $s:BLOCK_ORDER=True"
MODELS="omat0-medium=mace-omat-0-medium.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5"
