# Pack 2: leave one out on top of all ten switches (side a = all on; side b = all with one switch off). b/a > 1
# means the switch helps.
source $(dirname ${BASH_SOURCE[0]})/common.sh
FM_ROOT=$B
SRC=$B/src-1bd4f3be
OUT=$B/runs/pack2-$SLURM_JOB_ID
STAGE=0  # env on $WORK: concurrent staged jobs sharing one cache break the OEq stand-in CUDA home (README)
PACK="no-r128|$s:R128=False $s:STAGE_EDGES=False;no-se|$s:STAGE_EDGES=False;no-vec|$w:SPLINE_VECTOR=2;no-ssh|$w:STAGE_SH=False;no-cfast|$c:COMPOSE_FAST=False;no-cplan|$c:COUNT_PLAN=False;no-cueq|$q:CUEQ_PROJECTED=False;no-tail|$t:GENERIC_FOLD_READOUT_TAIL=False"
MODELS="omat0-medium=mace-omat-0-medium.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5 --a-constant $ALL --b-constant $ALL"
