# Pack 1: each H200 switch group against the A100 defaults (side a), and all of them together.
source $(dirname ${BASH_SOURCE[0]})/common.sh
FM_ROOT=$B
SRC=$B/src-1bd4f3be
OUT=$B/runs/pack1-$SLURM_JOB_ID
STAGE=0  # env on $WORK: concurrent staged jobs sharing one cache break the OEq stand-in CUDA home (README)
PACK="spw|$s:SPLINE_W=True;spr|$s:SPLINE_W=True $s:R128=True;cskip|$c:COMPOSE_SKIP=True;cueq|$q:CUEQ_PROJECTED=True;tail|$t:GENERIC_FOLD_READOUT_TAIL=True;pb|$p:POWER_BACKWARD=True;all|$ALL;allpb|$ALL $p:POWER_BACKWARD=True"
MODELS="omat0-medium=mace-omat-0-medium.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5"
