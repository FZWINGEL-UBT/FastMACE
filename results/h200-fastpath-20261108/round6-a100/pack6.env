# Round 6 on the A100 (8 November 2026): side a = the A100 defaults of main 0d0eefae (the ten H200 switches on);
# b = each round-6 switch, then all three.
B=/home/atuin/v130cb/v130cb18/fm-a100omat
FM_ROOT=$B
SRC=$B/src-11297d45
OUT=$B/runs/pack6-$SLURM_JOB_ID
STAGE=0
w=fastmace.kernels.oeq_streaming.wprime_backward
s=fastmace.kernels.oeq_streaming.spline_forward
c=fastmace.kernels.triton.compose_skip
PACK="joined|$c:JOINED_LAYOUT=True;wse|$w:STAGE_EDGES=True;pf2|$s:PREFETCH_AHEAD=2;all3|$c:JOINED_LAYOUT=True $w:STAGE_EDGES=True $s:PREFETCH_AHEAD=2"
MODELS="omat0-medium=mace-omat-0-medium.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5"
