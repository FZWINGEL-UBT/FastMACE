export PYTHONPATH=$B/src-6c9d303f; cd $PYTHONPATH
for p in off23b-medium:MACE-OFF23b_medium.model off24-medium:MACE-OFF24_medium.model; do
  m=${p%%:*}; c=${p#*:}
  if [ $m = off23-large ]; then GS="$ORG/urea_cod1008787.cif $ORG/naphthalene_cod2311090.cif $ORG/paracetamol_cod2104364.cif@2x2x2 $ORG/water_216.extxyz@1x1x1"
  else GS="$ORG/urea_cod1008787.cif $ORG/naphthalene_cod2311090.cif $ORG/paracetamol_cod2104364.cif $ORG/water_216.extxyz@1x1x1"; fi
  R=$B/runs/gate-tables-$m-$SLURM_JOB_ID
  OUT=$R MODEL=$m CKPT=$c STRUCTS=x GATE_STRUCTS="$GS" GATE_NAME=default GATE_ARGS="--seed 20261015" bash tools/offpolar_ab.sh
  OUT=$R MODEL=$m CKPT=$c STRUCTS=x GATE_STRUCTS="$GS" GATE_NAME=candidate GATE_ARGS="--seed 20261015 --rewrites radial_tables=on" bash tools/offpolar_ab.sh
done
python $B/jobs/gatesum.py $B/runs/gate-tables-*-$SLURM_JOB_ID/gate-*.log
