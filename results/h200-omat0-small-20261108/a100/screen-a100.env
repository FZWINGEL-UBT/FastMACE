# OMAT-0 small on the A100 (9 November 2026): side a = small's A100 defaults of 14fbf87a (the decision 66 pair on);
# b = one change each: the A100 switches chosen on medium turned off, and the H200 small-specific ones.
B=/home/atuin/v130cb/v130cb18/fm-omat0small
FM_ROOT=$B
SRC=$B/src-14fbf87a
OUT=$B/runs/screen-a100-$SLURM_JOB_ID
STAGE=0
CACHE=$B/cache
s=fastmace.kernels.oeq_streaming.spline_forward
w=fastmace.kernels.oeq_streaming.wprime_backward
c=fastmace.kernels.triton.compose_skip
t=fastmace.kernels.cutlass.tf32x3
n=fastmace.neighbors.skin
mb8="$s:R128_MIN_BLOCKS_MODEL_GPUS={'omat0-small':(8,('NVIDIA\x20A100-SXM4-80GB',))}"
mb7="$s:R128_MIN_BLOCKS_MODEL_GPUS={'omat0-small':(7,('NVIDIA\x20A100-SXM4-80GB',))}"
PACK="mb8|$mb8;mb7|$mb7;alphaoff|$w:FOLD_ALPHA=False;tile6432|$t:TILE='64x32';wshoff|$w:STAGE_SH=False;prefetchoff|$s:PREFETCH_AHEAD=False;wedgesoff|$w:STAGE_EDGES=False;joinedoff|$c:JOINED_LAYOUT=False"
MODELS="omat0-small=mace-omat-0-small.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5"
