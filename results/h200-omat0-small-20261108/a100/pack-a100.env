# OMAT-0 small on the A100 (9 November 2026): side a = small's A100 defaults (decision 66 pair off: its per-model
# lists hold the H200 only); b = 3xTF32 GEMMs, the generic w' backward, then both (the pair, as on the H200).
B=/home/atuin/v130cb/v130cb18/fm-omat0small
FM_ROOT=$B
SRC=$B/src-7790b57c
OUT=$B/runs/pack-a100-$SLURM_JOB_ID
STAGE=0
CACHE=$B/cache
f=fastmace.planner.fixed
A="{'omat0-small':('NVIDIA\x20A100-SXM4-80GB',)}"
tf="$f:DECISION_66_TF32X3_MODEL_GPUS=$A"
gw="$f:DECISION_66_GENERIC_WPRIME_LABEL_GPUS=$A"
PACK="pair|$tf $gw;tf32|$tf;wprime|$gw"
MODELS="omat0-small=mace-omat-0-small.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5"
