# OMAT-0 small on the A100 (9 November 2026): confirm PREFETCH_AHEAD off as small's default (50480105); a = small's
# A100 defaults; b = PREFETCH_AHEAD back on (empty per-model table), w' FOLD_ALPHA off, and both.
B=/home/atuin/v130cb/v130cb18/fm-omat0small
FM_ROOT=$B
SRC=$B/src-50480105
OUT=$B/runs/confirm-a100-$SLURM_JOB_ID
STAGE=0
CACHE=$B/cache
s=fastmace.kernels.oeq_streaming.spline_forward
w=fastmace.kernels.oeq_streaming.wprime_backward
PACK="prefetchon|$s:PREFETCH_AHEAD_MODEL_OFF_GPUS={};alphaoff|$w:FOLD_ALPHA=False;prefetchon-alphaoff|$s:PREFETCH_AHEAD_MODEL_OFF_GPUS={} $w:FOLD_ALPHA=False"
MODELS="omat0-small=mace-omat-0-small.model"
STRUCTURES="results/loup-a100-20261103/SrTiO3.cif@10x10x10"
WARMUP=200; BLOCK=256; BLOCKS=6
EXTRA="--timestep-fs 1 --a-neighbours skin=0.5 --b-neighbours skin=0.5"
